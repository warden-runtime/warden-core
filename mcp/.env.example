# Warden engine control-plane base URL (optional; defaults to http://127.0.0.1:8000).
ENGINE_URL=http://127.0.0.1:8000

# MCP transport: stdio (default, for Cursor/Claude Desktop) or streamable-http.
WARDEN_MCP_TRANSPORT=stdio

# Streamable HTTP bind settings (when WARDEN_MCP_TRANSPORT=streamable-http).
WARDEN_MCP_HOST=127.0.0.1
WARDEN_MCP_PORT=8765

# Engine HTTP client timeout in seconds.
WARDEN_MCP_HTTP_TIMEOUT_S=30

# Max manifest yaml_content size in bytes before POST (default 2 MiB).
# WARDEN_MCP_MANIFEST_MAX_BYTES=2097152
